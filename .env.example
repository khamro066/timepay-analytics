# Time Pay HR API configuration
TIMEPAY_BASE_URL=https://api.app.time-pay.uz
TIMEPAY_REFRESH_TOKEN=your-refresh-token-here
REFRESH_ENDPOINT=/api/v1/user/token/refresh/

# Database
# A relative sqlite path here is resolved against the project root
# (BASE_DIR in config.py), not the server's working directory.
DATABASE_URL=sqlite:///./timepay.db

# Our own API auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace-with-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
